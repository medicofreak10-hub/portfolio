# Copy this file to .env and fill in values. .env is git-ignored. Never commit it.

# Port the app listens on
PORT=8080

# live = real market data (default) | demo = synthetic offline data (clearly labelled)
DATA_MODE=live

# --- Evening email summary (Gmail) ---
# Create an App Password: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TO=

# --- Browser push notifications (run `npm run vapid` to generate) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Optional: protect the app with a PIN (recommended when opening it from your phone) ---
APP_PIN=
