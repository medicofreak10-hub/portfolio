{
  "name": "my-halal-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal read-only Shariah-aware portfolio tracker for NSE/BSE",
  "scripts": {
    "setup": "npm install && npm run build",
    "start": "node server/index.js",
    "demo": "node server/index.js --demo",
    "dev": "concurrently -n api,web -c cyan,magenta \"node --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "test": "node --test tests/*.test.js",
    "vapid": "node server/scripts/vapid.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "fast-xml-parser": "^5.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "web-push": "^4.0.0",
    "yahoo-finance2": "^3.14.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.108.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "concurrently": "^10.0.7",
    "lightweight-charts": "^4.2.3",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^2.15.4",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^0.21.2",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
